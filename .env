# ============================================================
#  Persian Search Console - فایل نمونه تنظیمات محیط
#  این فایل را به .env کپی کنید و مقادیر را پر نمایید
# ============================================================

# --- دیتابیس (پیش‌فرض SQLite) ---
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# --- Google OAuth 2.0 ---
# بعد از ساخت پروژه در Google Cloud Console این مقادیر را پر کنید
# راهنمای کامل در فایل README.md بخش «راه‌اندازی Google Cloud»
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# آدرس بازگشت (Redirect URI) که باید در Google Cloud Console ثبت شود
# اگر روی پورت 3000 اجرا می‌کنید همان پیش‌فرض بگذارید
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# --- عمومی ---
# آدرس پایه برنامه برای ساخت لینک‌های OAuth
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# مدت اعتبار نشست کاربر به ساعت (پیش‌فرض ۷۲۰ ساعت = ۳۰ روز)
SESSION_MAX_AGE_HOURS="720"

# مدت کش داده‌ها به ثانیه (پیش‌فرض ۳۰۰ ثانیه = ۵ دقیقه)
DATA_CACHE_TTL_SECONDS="300"
